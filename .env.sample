# ==========================================================================
# Tailor Studio — environment config. Copy to `.env` and fill in.
# Only ANTHROPIC_API_KEY and STUDIO_SESSION_SECRET are strictly required.
# ==========================================================================

# --- Claude API (REQUIRED) ------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Models (optional — sensible defaults shown) --------------------------
# The writer (bullets + summary). Keep on Sonnet for resume prose quality.
# TAILOR_MODEL=claude-sonnet-4-6
# The judge (adjacency defensibility + truthful skills rewrite). Sonnet.
# JUDGE_MODEL=claude-sonnet-4-6
# Cheap extraction (JD analysis, normalization). Haiku.
# EXTRACT_MODEL=claude-haiku-4-5-20251001
# Re-run adjacency on the tailored doc for accurate final coverage scoring.
# Set 0 to skip it (~few seconds faster/JD; resume is identical either way).
# FINAL_ADJACENCY=1

# --- Web server -----------------------------------------------------------
# Long random string for signing session cookies. REQUIRED in production.
# Rotate to force-logout everyone. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
STUDIO_SESSION_SECRET=replace-me-with-a-long-random-string
# STUDIO_HOST=127.0.0.1
# STUDIO_PORT=8001
# How many jobs tailor concurrently (the thread pool). Lower if you hit
# Anthropic rate limits (429s). IMPORTANT: this is threads, NOT uvicorn
# --workers — always run a SINGLE uvicorn process (chat + queue are in-process).
# STUDIO_WORKERS=8
# Set to true only when serving over HTTPS (marks the session cookie Secure).
# STUDIO_COOKIE_SECURE=false

# --- Admins ---------------------------------------------------------------
# Comma-separated list of admin emails. Anyone who signs up with one of these
# is auto-promoted to admin (and auto-approved). Everyone else signs up
# "pending" until an admin approves them on the Members page.
STUDIO_ADMIN_EMAILS=you@example.com
# Legacy single-admin var (still honored, merged with the list above).
# STUDIO_ADMIN_EMAIL=you@example.com
# Bootstrap: if no admin is configured AND none exists yet, the FIRST account
# to register becomes the admin. Lets a fresh clone "just register as admin"
# with zero config. Set to 0 on public deployments to disable.
# STUDIO_BOOTSTRAP_ADMIN=1

# --- Storage --------------------------------------------------------------
# Where the SQLite DB and generated resumes live. Defaults under tailor_studio/data.
# STUDIO_DATA_DIR=
# STUDIO_DB_PATH=

# --- Team chat (optional) -------------------------------------------------
# Free Giphy API key (https://developers.giphy.com) to enable GIF search in
# the chat. Without it, GIF search is hidden; pasted GIF/image links still render.
# STUDIO_GIPHY_KEY=

# --- Misc -----------------------------------------------------------------
# Max URLs accepted per batch paste.
# STUDIO_MAX_URLS_PER_BATCH=200
